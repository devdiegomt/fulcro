---
import Base from './Base.astro';
interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---
<Base titulo={titulo} descripcion={descripcion}>
  <section class="seccion">
    <article class="caja texto">
      <p class="etiqueta">Legal</p>
      <h1 style="margin-top:18px">{titulo}</h1>
      <p class="fecha">Última actualización: {actualizado}</p>
      <slot />
    </article>
  </section>
</Base>
