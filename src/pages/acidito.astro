---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portada from '../assets/acidito-portada.png';
import jefe from '../assets/acidito-jefe.png';
import magma from '../assets/acidito-magma.png';
import oscuro from '../assets/acidito-oscuro.png';
import { acidito, aprende } from '../config';

const jugar = acidito.jugar;
const avisos = `https://instagram.com/${aprende.instagram}`;

const personajes = [
  { nombre: 'Chispa', elemento: 'Fuego', poder: 'Derrite el hielo y prende las antorchas. En la oscuridad, es la única que alumbra.', color: '#ff7a3d' },
  { nombre: 'Gota', elemento: 'Agua', poder: 'Disuelve la sal y nada donde los otros se ahogarían.', color: '#3fa4ff' },
  { nombre: 'Acidito', elemento: 'Ácido', poder: 'Corroe el óxido y abre caminos que parecían cerrados. Lleva chupete.', color: '#7ad94a' },
];

const modos = [
  { t: 'Los tres en un PC', d: 'Cada uno con su parte del teclado. Como jugar en el sofá.' },
  { t: 'Online, cada uno en su casa', d: 'Uno crea la sala, los otros entran con el código. Conexión directa entre los tres.' },
  { t: 'En el celular', d: 'Controles táctiles en la pantalla, en el mismo aparato o cada uno en el suyo.' },
  { t: 'Editor de niveles', d: 'Diseña tus propios niveles, pruébalos al momento y expórtalos.' },
];

const mundos = [
  { n: 'Temporada 1', t: 'El templo', jefe: 'El Guardián', d: '21 niveles para aprender a moverse juntos: palancas, cajas, portales y llaves cruzadas.' },
  { n: 'Mundo 1', t: 'Las cuevas de obsidiana', jefe: 'El Gólem de magma' },
  { n: 'Mundo 2', t: 'Las galerías inundadas', jefe: 'La Hidra del aljibe' },
  { n: 'Mundo 3', t: 'Las minas a oscuras', jefe: 'La Sombra de la mina' },
  { n: 'Mundo 4', t: 'Las fuentes hirvientes', jefe: 'El Cangrejo hirviente' },
  { n: 'Mundo 5', t: 'La forja abandonada', jefe: 'El Autómata de la forja' },
];
---
<Base
  titulo="Acidito — videojuego cooperativo para tres"
  descripcion={`Acidito es un juego de plataformas cooperativo para tres: Chispa, Gota y Acidito, cada uno inmune a su elemento. ${acidito.niveles} niveles, jefes, modo online y celular.`}
  imagen="/og/acidito.png"
  datos={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Acidito',
    genre: ['Plataformas', 'Cooperativo', 'Puzle'],
    numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 3 },
    playMode: ['CoOp', 'MultiPlayer'],
    gamePlatform: ['Navegador web', 'Celular'],
    inLanguage: 'es',
  }}
>
  <div class="ac">
    <section class="ac-heroe">
      <div class="caja">
        <p class="ac-rotulo">Videojuego · de Fulcro</p>
        <h1>Acidito</h1>
        <p class="ac-lema">Tres amigos, tres elementos,<br />una sola salida.</p>
        <p class="ac-bajada">
          Lleven a Chispa, Gota y Acidito cada uno a su puerta. El problema: cada uno solo sobrevive a su elemento, y
          ninguno llega sin la ayuda de los otros dos.
        </p>
        <div class="botones">
          {jugar ? (
            <a class="ac-boton" href={jugar} target="_blank" rel="noopener">Jugar ahora</a>
          ) : (
            <a class="ac-boton" href={avisos} target="_blank" rel="noopener">Pronto · avísame cuando salga</a>
          )}
          <a class="ac-boton-borde" href="#mundos">Ver los mundos</a>
        </div>
        <p class="ac-pequeno">
          {acidito.niveles} niveles · {acidito.temporadas} temporadas · de 1 a 3 jugadores · en el navegador
        </p>
        <div class="ac-captura">
          <Image src={portada} alt="Portada de Acidito: Chispa, Gota y Acidito junto al menú del juego" widths={[800, 1400, 2000]} sizes="(min-width: 1200px) 1100px, 94vw" loading="eager" />
        </div>
      </div>
    </section>

    <section class="ac-seccion">
      <div class="caja">
        <p class="ac-rotulo">Los personajes</p>
        <h2>Cada uno sobrevive solo a lo suyo.</h2>
        <div class="rejilla rejilla-3 ac-personajes">
          {personajes.map((p) => (
            <div class="ac-personaje revelar" style={`--c:${p.color}`}>
              <p class="ac-elemento">{p.elemento}</p>
              <h3>{p.nombre}</h3>
              <p>{p.poder}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ac-seccion">
      <div class="caja">
        <p class="ac-rotulo">Cómo se juega</p>
        <h2>Juntos, en el mismo sofá o cada uno en su casa.</h2>
        <div class="ac-modos">
          {modos.map((m) => (
            <div class="revelar"><h3>{m.t}</h3><p>{m.d}</p></div>
          ))}
        </div>
        <div class="ac-galeria">
          <figure class="revelar">
            <Image src={jefe} alt="Nivel «El último guardián»: llaves, hielo, lava y las tres puertas" widths={[700, 1200]} sizes="(min-width: 900px) 560px, 94vw" />
            <figcaption>Cada disparo tiene su lugar: busquen desde dónde se llega.</figcaption>
          </figure>
          <figure class="revelar">
            <Image src={magma} alt="Pelea contra el Gólem de magma" widths={[700, 1200]} sizes="(min-width: 900px) 560px, 94vw" />
            <figcaption>El Gólem de magma solo le teme al agua.</figcaption>
          </figure>
          <figure class="revelar ac-ancha">
            <Image src={oscuro} alt="Nivel «Sin luz»: todo a oscuras y solo Chispa alumbra" widths={[900, 1600]} sizes="(min-width: 1200px) 1100px, 94vw" />
            <figcaption>En las minas todo está a oscuras: Chispa alumbra y prende las antorchas.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="ac-seccion" id="mundos">
      <div class="caja">
        <p class="ac-rotulo">Los mundos</p>
        <h2>Del templo a las profundidades.</h2>
        <p class="ac-bajada">
          Después del templo vienen «Las profundidades»: cinco mundos, cada uno con su mecánica —marea que sube,
          oscuridad, géiseres, prensas— y un jefe al final. El progreso se guarda con un código que puedes copiar o
          mandar.
        </p>
        <ol class="ac-mundos">
          {mundos.map((m) => (
            <li class="revelar">
              <span>{m.n}</span>
              <div>
                <h3>{m.t}</h3>
                {m.d && <p>{m.d}</p>}
              </div>
              <p class="ac-jefe">Jefe: {m.jefe}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Acidito conserva lo del juego: café oscuro, dorado y los tres colores. */
  .ac {
    --a-fondo: #0d0b08;
    --a-carta: #1a150f;
    --a-borde: #3b3022;
    --a-texto: #f3e6c8;
    --a-suave: #b3a58a;
    --a-oro: #ffd77a;
    --a-oro-claro: #ffe9b8;
    background:
      radial-gradient(60% 40% at 15% 0%, rgb(255 122 61 / 0.12), transparent 70%),
      radial-gradient(50% 40% at 85% 10%, rgb(122 217 74 / 0.1), transparent 70%),
      var(--a-fondo);
    color: var(--a-texto);
  }
  .ac h1,
  .ac h2,
  .ac h3 {
    font-family: 'Fredoka Variable', var(--f-titulo);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .ac-rotulo {
    font: 600 13px/1 var(--f-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--a-oro);
  }
  .ac-heroe {
    padding-top: clamp(56px, 8vw, 96px);
    text-align: center;
  }
  .ac-heroe h1 {
    font-size: clamp(72px, 13vw, 168px);
    line-height: 0.95;
    margin: 18px auto 0;
    width: fit-content;
    background: linear-gradient(90deg, #ff7a3d 10%, #3fa4ff 50%, #7ad94a 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ac-lema {
    margin-top: 16px;
    font: 600 clamp(24px, 3vw, 34px) / 1.25 'Fredoka Variable', var(--f-titulo);
    color: var(--a-oro-claro);
  }
  .ac-bajada {
    margin: 18px auto 0;
    max-width: 56ch;
    color: var(--a-suave);
    font-size: clamp(17px, 1.6vw, 19px);
  }
  .ac-seccion .ac-bajada {
    margin-inline: 0;
  }
  .ac-heroe .botones {
    justify-content: center;
    margin-top: 32px;
  }
  .ac-boton,
  .ac-boton-borde {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 12px 26px;
    border-radius: 14px;
    font: 600 18px/1 'Fredoka Variable', var(--f-texto);
    text-decoration: none;
    border: 2px solid var(--a-oro);
    transition: transform 0.15s, background 0.15s;
  }
  .ac-boton {
    background: var(--a-oro);
    color: #1a150f;
    box-shadow: 0 5px 0 #b8892f;
  }
  .ac-boton:hover {
    transform: translateY(-2px);
  }
  .ac-boton:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #b8892f;
  }
  .ac-boton-borde {
    color: var(--a-oro-claro);
  }
  .ac-boton-borde:hover {
    background: rgb(255 215 122 / 0.12);
  }
  .ac-pequeno {
    margin-top: 16px;
    font-size: 14px;
    color: var(--a-suave);
  }
  .ac-captura {
    margin: clamp(40px, 6vw, 64px) auto 0;
    max-width: 1100px;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid var(--a-borde);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  .ac-seccion {
    padding-block: clamp(64px, 9vw, 120px);
  }
  .ac-heroe + .ac-seccion {
    padding-top: clamp(80px, 10vw, 136px);
  }
  .ac-seccion h2 {
    font-size: clamp(34px, 4.8vw, 56px);
    margin-top: 16px;
    max-width: 20ch;
    line-height: 1.05;
  }
  .ac-personajes {
    margin-top: 40px;
  }
  .ac-personaje {
    background: var(--a-carta);
    border: 2px solid var(--a-borde);
    border-top: 6px solid var(--c);
    border-radius: 18px;
    padding: 28px;
  }
  .ac-elemento {
    font: 600 12.5px/1 var(--f-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }
  .ac-personaje h3 {
    font-size: 40px;
    margin-top: 10px;
    color: var(--c);
  }
  .ac-personaje p:last-child {
    margin-top: 10px;
    color: var(--a-suave);
  }
  .ac-modos {
    margin-top: 40px;
    display: grid;
    gap: 28px 32px;
  }
  @media (min-width: 700px) {
    .ac-modos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .ac-modos {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ac-modos > div {
    border-top: 2px solid var(--a-oro);
    padding-top: 16px;
  }
  .ac-modos h3 {
    font-size: 22px;
  }
  .ac-modos p {
    margin-top: 8px;
    color: var(--a-suave);
  }
  .ac-galeria {
    margin-top: 56px;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .ac-galeria {
      grid-template-columns: 1fr 1fr;
    }
    .ac-ancha {
      grid-column: 1 / -1;
    }
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    border-radius: 14px;
    border: 2px solid var(--a-borde);
  }
  figcaption {
    margin-top: 10px;
    color: var(--a-suave);
    font-size: 15px;
  }
  .ac-mundos {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border-top: 2px solid var(--a-borde);
  }
  .ac-mundos li {
    display: grid;
    gap: 6px 24px;
    padding-block: 22px;
    border-bottom: 2px solid var(--a-borde);
  }
  @media (min-width: 760px) {
    .ac-mundos li {
      grid-template-columns: 150px 1fr auto;
      align-items: baseline;
    }
  }
  .ac-mundos span {
    font: 600 13px var(--f-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--a-oro);
  }
  .ac-mundos h3 {
    font-size: 28px;
  }
  .ac-mundos div p {
    margin-top: 6px;
    color: var(--a-suave);
  }
  .ac-jefe {
    color: var(--a-oro-claro);
    font-weight: 600;
  }
  .ac :focus-visible {
    outline-color: var(--a-oro);
  }
</style>
