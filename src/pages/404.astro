---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" descripcion="Esta página no existe.">
  <section class="seccion">
    <div class="caja">
      <p class="etiqueta">Error 404</p>
      <h1 style="font-size:clamp(44px,7vw,84px);margin-top:18px;max-width:14ch">Esta página se nos perdió.</h1>
      <div class="botones" style="margin-top:32px">
        <a class="boton boton-tinta" href="/">Volver al inicio</a>
        <a class="boton boton-borde" href="/contacto">Contacto</a>
      </div>
    </div>
  </section>
</Base>
